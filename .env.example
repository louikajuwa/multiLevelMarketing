APP_NAME="MLM Enterprise"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL container) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mlm
DB_USERNAME=mlm_user
DB_PASSWORD=mlm_secret
DB_ROOT_PASSWORD=root_secret

# --- Redis (cache / queue / session) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# --- Real-time bridge (Laravel publishes to Redis; Node relays via Socket.IO) ---
SOCKET_CHANNEL=mlm.events
# Shared HMAC secret for socket handshake tokens (generated on setup).
SOCKET_SECRET=

# --- Mail (provider-agnostic) ---
# Local dev = Mailpit. Production = SendGrid over SMTP (change creds only, no code change).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@mlm.test"
MAIL_FROM_NAME="${APP_NAME}"

# SendGrid over SMTP (production example):
#   MAIL_HOST=smtp.sendgrid.net
#   MAIL_PORT=587
#   MAIL_USERNAME=apikey
#   MAIL_PASSWORD=<your-sendgrid-api-key>
#   MAIL_SCHEME=tls

VITE_APP_NAME="${APP_NAME}"
